# OpenCleaner test image: rockylinux:9 with the test tools already installed.
# Logic tests only: Rocky 9 has GTK 4.6, below the 4.8 the window needs, so no Xvfb/ImageMagick here.
# Metadata never expires inside the image, so test runs do not download it again.
FROM rockylinux:9
RUN echo "metadata_expire=-1" >> /etc/dnf/dnf.conf \
 && dnf -y -q install python3 python3-gobject gtk4 libadwaita tree xterm \
 && dnf -y -q remove xterm \
 && dnf -y -q makecache \
 && printf '#!/bin/sh\nexec "$@"\n' > /usr/local/bin/pkexec && chmod +x /usr/local/bin/pkexec
