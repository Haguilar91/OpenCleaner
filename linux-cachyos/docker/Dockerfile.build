# Build environment for the single-file Linux executable. Debian 12 is the oldest base the app
# supports (glibc 2.36, GTK 4.8, libadwaita 1.2), so a binary built here also runs on newer distros.
FROM debian:bookworm
RUN apt-get update -qq \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \
    python3 python3-venv python3-pip python3-gi python3-gi-cairo gir1.2-gtk-4.0 gir1.2-adw-1 \
    libpython3.11 binutils ca-certificates adwaita-icon-theme \
 && rm -rf /var/lib/apt/lists/*
